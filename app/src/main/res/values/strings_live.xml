<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Live TV: category column. Keep short: the column is narrow -->
    <string name="live_all_channels">All channels</string>
    <!-- Placeholder in the filter box above the channel list -->
    <string name="live_filter_hint">Filter by name or number</string>
    <!-- Buttons switching between the channel list and the TV guide grid. Keep short (small buttons) -->
    <string name="live_view_list">List</string>
    <string name="live_view_guide">TV guide</string>
    <string name="live_no_channels">No channels here yet.</string>
    <!-- Under the programme on now. %1$s is a start time (20:00), %2$s the next programme's title. Keep short (one line) -->
    <string name="live_next">Next %1$s %2$s</string>
    <!-- Under the programme on now, when nothing follows. %1$s is its end time (20:00) -->
    <string name="live_until">Until %1$s</string>

    <!-- Channel options menu -->
    <string name="live_option_find_series">Find series</string>
    <string name="live_option_find_movie">Find in Movies</string>
    <!-- %1$s is a programme title; keep the quotation marks of your language around it -->
    <string name="live_option_search_for">Search for “%1$s”</string>
    <string name="live_option_find_help">Watch it on demand</string>
    <string name="live_option_channel_guide">Show TV guide for this channel</string>
    <string name="live_option_channel_guide_help">Upcoming programmes</string>
    <string name="live_option_switch_to_list">Switch to channel list</string>
    <string name="live_option_switch_to_grid">Switch to TV guide grid</string>
    <!-- "Guide" is a button on the TV remote -->
    <string name="live_option_switch_help">Or press the Guide button on the remote</string>
    <string name="live_option_hide_channel">Hide channel</string>
    <!-- "Settings › Languages & categories" names a settings page: keep it the same as that page's title -->
    <string name="live_option_hide_channel_help">Unhide later in Settings › Languages &amp; categories</string>

    <!-- TV guide grid -->
    <!-- Touch buttons moving the guide's time window back or forward. Very short: they sit above the narrow channel column -->
    <string name="live_guide_earlier">Earlier</string>
    <string name="live_guide_later">Later</string>

    <!-- TV guide sources (settings page) -->
    <string name="live_guide_sources_intro">Guides are updated every day. Programmes are only stored for channels that use them, for the next 3 days.</string>
    <!-- Button and panel title. Keep short -->
    <string name="live_guide_add">Add a guide</string>
    <!-- Button. Keep short -->
    <string name="live_guide_update_now">Update guide now</string>
    <!-- Button -->
    <string name="live_guide_match_missing">Match channels without a guide</string>
    <string name="live_guide_yours">Your guides</string>
    <!-- "XMLTV" is a file format name: don't translate it -->
    <string name="live_guide_none_yet">No guides yet. Add a free guide for your country, or your own XMLTV address.</string>
    <!-- %1$s is an error message -->
    <string name="live_guide_last_failed">Last update failed: %1$s</string>
    <!-- %1$s is the title of the task still running -->
    <string name="live_guide_wait">Wait for this to finish first: %1$s</string>
    <!-- "XMLTV" is a file format name: don't translate it -->
    <string name="live_guide_own_address">Your own XMLTV address</string>
    <string name="live_guide_name_hint">Name (optional)</string>
    <!-- Button. Keep short -->
    <string name="live_guide_add_this">Add this guide</string>
    <string name="live_guide_free_title">Free guides by country</string>
    <!-- "iptv-epg.org" is a web site: don't translate it -->
    <string name="live_guide_free_note">From iptv-epg.org. Large countries can take a few minutes to load on a TV box.</string>
    <!-- A guide's details, joined with " · ": where it comes from -->
    <string name="live_guide_from_provider">From your provider</string>
    <!-- A guide's details: how many channels it has. %1$s is the number. -->
    <plurals name="live_guide_source_channels">
        <item quantity="one">%1$s channel</item>
        <item quantity="other">%1$s channels</item>
    </plurals>
    <!-- A guide's details: the guide is switched off -->
    <string name="live_guide_source_off">off</string>

    <!-- Progress and outcomes of guide updates. %1$s is a guide's name or web address -->
    <string name="live_guide_adding">Adding %1$s</string>
    <string name="live_guide_added">%1$s added</string>
    <string name="live_guide_load_failed">Couldn\'t load %1$s</string>
    <string name="live_guide_updating">Updating the TV guide</string>
    <string name="live_guide_updated">TV guide updated</string>
    <string name="live_guide_some_failed">Some guides couldn\'t be loaded</string>
    <!-- %1$s is a list of guide names, %2$s an error message -->
    <string name="live_guide_matching">Matching channels without a guide</string>
    <!-- %1$s is how many more channels now have a guide -->
    <plurals name="live_guide_match_found">
        <item quantity="one">Found a guide for %1$s channel more</item>
        <item quantity="other">Found a guide for %1$s channels more</item>
    </plurals>
    <string name="live_guide_match_all">Every channel has a guide</string>
    <string name="live_guide_match_none_left">No channels left to match</string>
    <string name="live_guide_match_none_new">No new matches found</string>
    <!-- %1$s is how many channels have a guide -->
    <plurals name="live_guide_coverage">
        <item quantity="one">%1$s channel has a guide.</item>
        <item quantity="other">%1$s channels have a guide.</item>
    </plurals>
    <!-- %1$s is how many channels have a guide, %2$s how many more than before the update -->
    <plurals name="live_guide_coverage_more">
        <item quantity="one">%1$s channel has a guide (%2$s more than before).</item>
        <item quantity="other">%1$s channels have a guide (%2$s more than before).</item>
    </plurals>
    <!-- Follows live_guide_coverage. %1$s is how many channels still have no guide. "TV guide matching" names a screen -->
    <plurals name="live_guide_coverage_none">
        <item quantity="one">%1$s still has none: you can choose it by hand in TV guide matching.</item>
        <item quantity="other">%1$s still have none: you can choose them by hand in TV guide matching.</item>
    </plurals>

    <!-- TV guide matching screen -->
    <string name="live_guide_matching_intro">Pick which guide data each channel uses. Your choices are kept when the playlist updates.</string>
    <!-- Tabs, followed by a count. Keep short: four tabs share the title's row -->
    <string name="live_guide_tab_all">All</string>
    <string name="live_guide_tab_auto">Automatic</string>
    <string name="live_guide_tab_manual">Set by you</string>
    <!-- Tab (channels without a guide) and button (use no guide for this channel). Keep short -->
    <string name="live_guide_no_guide">No guide</string>
    <!-- A tab: %1$s is its name, %2$s how many channels it has -->
    <string name="live_guide_filter_hint">Filter your channels by name</string>
    <string name="live_guide_no_data">No guide data</string>
    <!-- Small capitalised status chips beside each channel. Very short -->
    <string name="live_guide_chip_none">NO GUIDE</string>
    <string name="live_guide_chip_set">SET</string>
    <!-- %1$d is how confident the automatic match is, in percent -->
    <string name="live_guide_chip_auto">AUTO %1$d%%</string>
    <string name="live_guide_select_channel">Select a channel on the left to choose its guide.</string>
    <!-- Followed, on the next line, by a channel name -->
    <string name="live_guide_choose_for">Choose a guide for</string>
    <string name="live_guide_current_none">Currently: no guide</string>
    <!-- %1$s is a guide channel's name, %2$s the guide it comes from -->
    <string name="live_guide_current">Currently: %1$s (%2$s)</string>
    <!-- %1$s is a guide channel's name, %2$s the guide it comes from, %3$d hours the programme times are shifted by. "h" is short for hours -->
    <string name="live_guide_current_shifted">Currently: %1$s (%2$s) · shifted %3$dh</string>
    <string name="live_guide_search_hint">Search all guide channels</string>
    <!-- %1$d is how well a guide channel matches, in percent. Keep short -->
    <string name="live_guide_match_score">%1$d%% match</string>
    <string name="live_guide_no_results">No guide channels found. Try a shorter search, or add another guide source.</string>
    <!-- Button. %1$d is hours the programme times are shifted by. "h" is short for hours. Keep short -->
    <string name="live_guide_time_shift">Time shift: %1$d h</string>
    <!-- Button. Keep short -->
    <string name="live_guide_reset">Reset to automatic</string>
</resources>
